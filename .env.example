VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel Edge 代理用（与上面两项值相同；仅部署环境需要，本地可不加）
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only Kimi / Moonshot API key for /api/ai-comment. Do not expose it with a VITE_ prefix.
MOONSHOT_API_KEY=

# Optional: set to 0 only if you run `vite preview` and need the browser to call Supabase directly (no /api proxy).
# VITE_USE_SUPABASE_EDGE_PROXY=0
